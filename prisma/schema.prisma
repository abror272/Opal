// Opal Clone - Prisma Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model BlockApp {
  id               String   @id @default(cuid())
  name             String
  emoji            String
  gradient         String   @default("from-slate-400 to-slate-600")
  category         String   @default("Ijtimoiy tarmoq")
  blocked          Boolean  @default(false)
  dailyLimitMinutes Int     @default(0)
  todayMinutes     Int      @default(0)
  order            Int      @default(0)
  createdAt        DateTime @default(now())
}

model FocusSession {
  id              String    @id @default(cuid())
  type            String
  label           String
  emoji           String    @default("🎯")
  durationMinutes Int
  startedAt       DateTime  @default(now())
  endedAt         DateTime?
  completed       Boolean   @default(false)
  savedMinutes    Int       @default(0)
  focusScore      Int       @default(0)
  blockedApps     String    @default("[]")
}

model DailyStat {
  id                String @id @default(cuid())
  date              String @unique
  screenTimeMinutes Int    @default(0)
  savedMinutes      Int    @default(0)
  pickups           Int    @default(0)
  goalMinutes       Int    @default(240)
}

model UserProfile {
  id                String  @id @default(cuid())
  name              String  @default("Aziz")
  handle            String  @default("@aziz.dev")
  streakDays        Int     @default(0)
  totalSavedMinutes Int     @default(0)
  totalSessions     Int     @default(0)
  protectionEnabled Boolean @default(true)
  strictMode        Boolean @default(false)
  goalMinutes       Int     @default(240)
  plan              String  @default("FREE")
}
